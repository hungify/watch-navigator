{
  "name": "watch-navigator-server",
  "version": "1.0.0",
  "description": "Cloudflare Workers Google Directions API Proxy for Watch Navigator",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types test/*.test.ts",
    "test": "pnpm run typecheck && pnpm run test:unit"
  },
  "keywords": [
    "directions",
    "google-maps",
    "proxy",
    "cloudflare-workers",
    "wear-engine",
    "typescript"
  ],
  "author": "hungify",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  }
}
